NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_ENV=development
PHONE_VERIFICATION_PROVIDER=test
VERIFY_GE_API_KEY=
# Twilio Verify sends SMS codes to foreign numbers only (ADR-055); Georgian numbers stay on
# Verify.ge. Leave any of the three unset and foreign numbers are refused at registration.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
NEXT_PUBLIC_AUTH_MODE=google
# Public finances (the /transparency page, its links, the homepage dues figure) stay hidden
# unless this is the word "true" (ADR-034). Server-side only; set it for the build too, since
# some pages are built ahead of time. Leave it unset to keep them hidden.
SHOW_PUBLIC_FINANCES=
# Events (the /events pages, the cabinet events tab and RSVP, the delegate team-RSVP card, the
# admin events editor) stay hidden unless this is the word "true" (ADR-042). Server-side only;
# set it for the build too. Leave it unset to keep them hidden.
SHOW_EVENTS=
# Ratings (the /leaderboard page and its header link, the homepage top five, a delegate's member
# count and rank on their profile, the delegate panel's place in the ranking, the chosen
# delegate's count in the member cabinet) stay hidden unless this is the word "true" (ADR-052).
# Server-side only; set it for the build too. Leave it unset to keep them hidden.
SHOW_RATINGS=
# The English version (the /en pages, the KA / EN language switch, English addresses in the
# sitemap) stays hidden unless this is the word "true" (ADR-054, changed 2026-10-20). While it is
# hidden every /en address redirects to its Georgian page. Server-side only; set it for the build
# too. Leave it unset to keep English hidden.
SHOW_ENGLISH=
# Google Search Console ownership code (the content of its google-site-verification tag). Adds
# the tag to every page when set; not a secret. Server-side only; set it for the build too.
# Leave it unset until the site is added in Search Console.
GOOGLE_SITE_VERIFICATION=
